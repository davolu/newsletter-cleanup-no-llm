# Required. TypeSafe key for Jev. TypeSafe does not include free credits.
# Add a small prepaid balance before the first run, or classification returns 402.
TYPESAFE_API_KEY=

# Required. Composio key. Composio holds the Gmail OAuth tokens; this app does not.
COMPOSIO_API_KEY=

# Hosted deploys need both. Leave both unset on your computer and state goes to
# .data/state.json, which git ignores. Serverless disks do not keep that file.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Required on Vercel. The scheduled path checks this header.
# Use letters and numbers only, at least 16 characters. Vercel sends it as
# Authorization: Bearer <CRON_SECRET>. Netlify and Railway call the runner
# directly and do not use this value.
CRON_SECRET=

# Optional. Defaults to jev-latest.
# TYPESAFE_MODEL=jev-latest

# Optional. Public origin when the host does not send forwarded headers.
# APP_ORIGIN=https://your-app.example
